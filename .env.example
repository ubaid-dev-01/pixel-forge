# =============================================================================
# PixelForge environment variables
# Copy to .env.local (web), apps/api/.env, and services/processor/.env
# Never commit real secrets.
# =============================================================================

# --- Frontend (Next.js on Vercel) ---
NEXT_PUBLIC_APP_NAME=PixelForge
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CONVEX_URL=https://YOUR_DEPLOYMENT.convex.cloud
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Public demo mode is used when the processing provider is unreachable.
NEXT_PUBLIC_DEMO_MODE=true

# --- Convex ---
CONVEX_DEPLOYMENT=dev:your-deployment
# Required by Convex Auth (password-only does not need SITE_URL for OAuth).
SITE_URL=http://localhost:3000
# Generated via `node scripts/generate-auth-keys.mjs` and set on the Convex dashboard.
JWT_PRIVATE_KEY=
JWKS=

# --- Node API (Express) ---
API_PORT=8080
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Convex URL used by the API to read/write job metadata as the authenticated user
# or via a server identity. The Python worker NEVER talks to Convex.
CONVEX_URL=https://YOUR_DEPLOYMENT.convex.cloud
# Service token for Node → Convex mutations that update job status.
CONVEX_DEPLOY_KEY=
API_CORS_ORIGINS=http://localhost:3000
API_REQUEST_TIMEOUT_MS=30000
# Internal webhook HMAC shared between the processor and the Node API.
PROCESSING_WEBHOOK_SECRET=change-me-in-production-use-a-long-random-string
# Same value as PROCESSING_WEBHOOK_SECRET unless you split them. Also set on Convex.
API_SERVICE_SECRET=change-me-in-production-use-a-long-random-string
# Public origin of the API — the worker POSTs HMAC webhooks here.
API_PUBLIC_URL=http://localhost:8080

# --- Object storage (S3-compatible: MinIO locally, R2/S3 in production) ---
# Secret key lives ONLY in the Node API. Python uses signed URLs.
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=pixelforge-media
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9000
SIGNED_UPLOAD_TTL_SECONDS=900
SIGNED_DOWNLOAD_TTL_SECONDS=600

# --- Processing provider ---
# local | replicate | gpu-worker | mock
PROCESSING_PROVIDER=local
PROCESSING_PROVIDER_URL=http://127.0.0.1:8090
PROCESSING_PROVIDER_TOKEN=change-me-processor-token
# Optional adapters. Leave empty unless that provider is selected.
REPLICATE_API_TOKEN=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
RUNPOD_API_KEY=
GPU_WORKER_URL=

# --- Usage / plans (billing-ready; no payment processor wired) ---
PLAN_FREE_IMAGE_JOBS=30
PLAN_FREE_VIDEO_JOBS=3
PLAN_FREE_BYTES=1073741824

# --- File limits ---
MAX_IMAGE_BYTES=52428800
MAX_VIDEO_BYTES=524288000
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_EDGE=8192
RETENTION_HOURS=168

# --- Python processor ---
PROCESSOR_HOST=0.0.0.0
PROCESSOR_PORT=8090
PROCESSOR_DEVICE=auto
PROCESSOR_MODEL_DIR=./model_cache
PROCESSOR_TMP_DIR=./tmp
PROCESSOR_MAX_CONCURRENCY=1
PROCESSOR_JOB_TIMEOUT_SECONDS=1800
# Internal auth for Node → processor. Same value as PROCESSING_PROVIDER_TOKEN.
PROCESSOR_AUTH_TOKEN=change-me-processor-token
# Models are downloaded lazily on first use. Set 0 to skip network downloads.
PROCESSOR_ALLOW_MODEL_DOWNLOAD=1
# Optional Hugging Face token for gated models (not required for default stack).
HF_TOKEN=
