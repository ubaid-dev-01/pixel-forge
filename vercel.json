{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && npm install",
      "buildCommand": "cd ../.. && npm run build --workspace=@pixelforge/web",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_BASE_URL"
        }
      ]
    },
    "api": {
      "root": "apps/api",
      "framework": "express",
      "installCommand": "cd ../.. && npm install",
      "functions": {
        "src/index.ts": {
          "maxDuration": 300,
          "memory": 1024
        }
      },
      "bindings": [
        {
          "type": "service",
          "service": "processor",
          "format": "url",
          "env": "PROCESSING_PROVIDER_URL"
        }
      ]
    },
    "processor": {
      "root": "services/processor",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "functions": {
        "app/main.py": {
          "maxDuration": 300,
          "memory": 3009
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
